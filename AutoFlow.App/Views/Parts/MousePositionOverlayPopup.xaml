<UserControl x:Class="AutoFlow.App.Views.Parts.MousePositionOverlayPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsHitTestVisible="False">
    <Border Style="{StaticResource AppOverlayCard}">
        <StackPanel>
            <TextBlock Style="{StaticResource AppOverlayLabel}"
                       Text="屏幕坐标" />
            <TextBlock x:Name="CoordinateTextBlock"
                       Style="{StaticResource AppOverlayPrimaryValue}"
                       Text="X 0, Y 0" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ColorPreviewBorder"
                        Style="{StaticResource AppOverlayColorSwatch}" />
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource AppOverlayLabel}"
                               Text="屏幕颜色" />
                    <TextBlock x:Name="ColorTextBlock"
                               Style="{StaticResource AppOverlaySecondaryValue}"
                               Text="#FFFFFF" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
