<UserControl x:Class="AutoFlow.App.Views.Parts.ScriptListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Style="{StaticResource Card}">
        <DockPanel>
            <Grid DockPanel.Dock="Top"
                  Margin="4,0,4,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource AppHeaderLine1}"
                           Text="脚本列表" />
                <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        Command="{Binding OpenScriptsFolderCommand}"
                        Content="脚本目录"
                        Style="{StaticResource AppTextButtonStyle}" />
            </Grid>

            <ListBox BorderThickness="0"
                     Padding="0"
                     Background="Transparent"
                     PreviewMouseRightButtonDown="ScriptList_OnPreviewMouseRightButtonDown"
                     ScrollViewer.CanContentScroll="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource AppListBoxContainerStyle}"
                     ItemTemplate="{StaticResource ScriptListItemTemplate}"
                     ItemsSource="{Binding Scripts}"
                     SelectedItem="{Binding SelectedScript, Mode=TwoWay}"
                     d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar"
                           BasedOn="{StaticResource AppScrollBarStyle}" />
                </ListBox.Resources>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
