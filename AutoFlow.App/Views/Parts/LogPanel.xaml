<UserControl x:Class="AutoFlow.App.Views.Parts.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top"
                       Margin="4,0,4,12">
                <TextBlock Style="{StaticResource AppHeaderLine1}"
                           Text="运行日志" />
            </DockPanel>

            <Border Background="{StaticResource BrushBackgroundDark}"
                    CornerRadius="6">
                <RichTextBox x:Name="LogOutputTextBox"
                             Padding="6"
                             Background="Transparent"
                             BorderThickness="0"
                             BorderBrush="Transparent"
                             FontFamily="Consolas"
                             FontSize="14"
                             Foreground="{StaticResource BrushWhite87}"
                             IsDocumentEnabled="False"
                             IsReadOnly="True"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto">
                    <RichTextBox.Resources>
                        <Style TargetType="ScrollBar"
                               BasedOn="{StaticResource LogOutputScrollBarStyle}" />
                    </RichTextBox.Resources>
                </RichTextBox>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
