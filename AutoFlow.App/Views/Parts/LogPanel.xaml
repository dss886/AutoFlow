<UserControl x:Class="AutoFlow.App.Views.Parts.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top"
                       Margin="4,0,4,12">
                <TextBlock Style="{StaticResource AppHeaderLine1}"
                           Text="运行日志" />
            </DockPanel>

            <Border Background="{DynamicResource AppBackgroundDark}"
                    CornerRadius="6">
                <TextBox x:Name="LogOutputTextBox"
                         IsReadOnly="True"
                         Padding="6"
                         Background="Transparent"
                         BorderThickness="0"
                         BorderBrush="Transparent"
                         FontFamily="Consolas"
                         FontSize="14"
                         Foreground="{StaticResource AppForegroundMuted}"
                         HorizontalScrollBarVisibility="Auto"
                         Text="{Binding LogOutput, Mode=OneWay}"
                         TextChanged="LogOutputTextBox_OnTextChanged"
                         VerticalScrollBarVisibility="Auto">
                    <TextBox.Resources>
                        <Style TargetType="ScrollBar"
                               BasedOn="{StaticResource LogOutputScrollBarStyle}" />
                    </TextBox.Resources>
                </TextBox>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
