<UserControl x:Class="AutoFlow.App.Views.Parts.RunControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="4,0,0,0"
                           Style="{StaticResource AppHeaderLine1}"
                           Text="运行控制" />
                <TextBlock Margin="12,2,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding MousePositionText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock"
                               BasedOn="{StaticResource AppTips}">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMousePositionVisible}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Margin="0,16,0,0"
                        Orientation="Horizontal">
                <Button Width="160"
                        Margin="0,0,8,0"
                        Command="{Binding ToggleRunStateCommand}"
                        Content="{Binding RunControlButtonText}">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScriptRunning}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="#FFDC2626" />
                                    <Setter Property="BorderBrush"
                                            Value="#FFDC2626" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Width="142"
                        Margin="0,0,8,0"
                        Command="{Binding OpenInEditorCommand}"
                        Content="外部编辑器打开"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Width="160"
                        Margin="0,0,8,0"
                        Command="{Binding ToggleMousePositionCommand}"
                        Content="{Binding MousePositionToggleButtonText}">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMousePositionVisible}"
                                             Value="True">
                                    <Setter Property="Foreground"
                                            Value="#FF0F172A" />
                                    <Setter Property="Background"
                                            Value="#FFDBEAFE" />
                                    <Setter Property="BorderBrush"
                                            Value="#FF93C5FD" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
