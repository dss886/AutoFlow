<UserControl x:Class="AutoFlow.App.Views.Parts.RunControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/">
    <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Margin="4,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource AppHeaderLine1}"
                           Text="运行控制" />
                <TextBlock Margin="12,2,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding MousePositionText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock"
                               BasedOn="{StaticResource AppTips}">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMousePositionVisible}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Width="88"
                        Margin="0,0,12,0"
                        Command="{Binding ToggleRunStateCommand}"
                        Content="{Binding RunControlButtonText}"
                        ContentTemplate="{StaticResource AppButtonWithIconTemplate}">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource AppButtonPrimaryStyle}">
                            <Setter Property="Tag"
                                    Value="{svgc:SvgImage Source=/Assets/Play.svg, AppName=AutoFlow.App}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScriptRunning}"
                                             Value="True">
                                    <Setter Property="Tag"
                                            Value="{svgc:SvgImage Source=/Assets/Pause.svg, AppName=AutoFlow.App}" />
                                    <Setter Property="Background"
                                            Value="{StaticResource BrushPrimaryWarning}" />
                                    <Setter Property="BorderBrush"
                                            Value="{StaticResource BrushPrimaryWarning}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Width="88"
                        Margin="0,0,12,0"
                        Content="录制"
                        Tag="{svgc:SvgImage Source=/Assets/Record.svg, AppName=AutoFlow.App}"
                        ContentTemplate="{StaticResource AppButtonWithIconTemplate}"
                        Style="{StaticResource AppButtonDangerStyle}" />
                <Button Width="88"
                        Command="{Binding ToggleMousePositionCommand}"
                        Content="{Binding MousePositionToggleButtonText}"
                        ContentTemplate="{StaticResource AppButtonWithIconTemplate}">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource AppButtonPlainStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMousePositionVisible}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource BrushPrimaryGreen}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushPrimaryGreen}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
