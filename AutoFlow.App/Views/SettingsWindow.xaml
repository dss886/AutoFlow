<Window x:Class="AutoFlow.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        Title="设置"
        Width="400"
        Height="720"
        MinWidth="400"
        MinHeight="720"
        Background="{StaticResource BrushBackgroundDark}"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        PreviewMouseDown="Window_OnPreviewMouseDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="16"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource AppHeaderLine1}"
                           Text="快捷键设置" />
                <TextBlock Margin="0,10,0,0"
                           Style="{StaticResource AppSubtitle}"
                           Text="按下 Esc 可取消当前绑定操作" />
            </StackPanel>

            <Button Grid.Column="1"
                    Click="CloseButton_OnClick"
                    Margin="0,-4,-4,0"
                    Style="{StaticResource AppIconButtonStyle}"
                    ToolTip="关闭"
                    VerticalAlignment="Top">
                <Image Width="12"
                       Height="12"
                       IsHitTestVisible="False"
                       Source="{svgc:SvgImage Source=/Assets/Close.svg, AppName=AutoFlow.App}" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Margin="0,16,0,16"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Bindings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12"
                                Padding="16,8,12,8"
                                Background="{StaticResource BrushBackground}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource AppHeaderLine2}"
                                               Text="{Binding DisplayName}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Margin="0,0,12,0"
                                            Click="ResetButton_OnClick"
                                            Style="{StaticResource AppIconButtonDarkStyle}"
                                            Tag="{Binding}"
                                            ToolTip="恢复默认">
                                        <Image Width="12"
                                               Height="12"
                                               IsHitTestVisible="False"
                                               Source="{svgc:SvgImage Source=/Assets/Refresh.svg, AppName=AutoFlow.App}" />
                                    </Button>
                                    <Button Width="160"
                                            Click="RebindButton_OnClick"
                                            Content="{Binding ShortcutText}"
                                            Style="{StaticResource AppButtonPlainStyle}"
                                            Tag="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
