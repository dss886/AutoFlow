<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefaultItemExcludes>$(DefaultItemExcludes);temp\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.10" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\AppIcon.png" />
    <None Remove="Assets\Close.svg" />
    <None Remove="Assets\Pause.svg" />
    <None Remove="Assets\Play.svg" />
    <None Remove="Assets\Refresh.svg" />
    <None Remove="Assets\Record.svg" />
    <None Remove="Assets\Settings.svg" />
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\Close.svg" />
    <Resource Include="Assets\Pause.svg" />
    <Resource Include="Assets\Play.svg" />
    <Resource Include="Assets\Refresh.svg" />
    <Resource Include="Assets\Record.svg" />
    <Resource Include="Assets\Settings.svg" />
  </ItemGroup>

</Project>
