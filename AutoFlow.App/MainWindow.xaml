<Window x:Class="AutomationHost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutomationHost.App"
        mc:Ignorable="d"
        Title="AutoFlow - Windows 自动化脚本宿主"
        Width="1100"
        Height="720"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16"
                Margin="0,0,0,16"
                Background="#FFF5F7FB"
                BorderBrush="#FFD6DCE8"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="AutoFlow - Windows 自动化脚本宿主" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#FF4A5568"
                               Text="使用 Lua 脚本编写和执行自动化任务。" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                        <Run Text="脚本目录: " />
                        <Run Text="{Binding ScriptsDirectory, Mode=OneWay}" FontFamily="Consolas" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Width="110" Margin="0,0,8,0" Click="OpenScriptsFolderButton_OnClick" Content="打开脚本目录" />
                    <Button Width="110" Click="RefreshScriptsButton_OnClick" Content="刷新脚本列表" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    Background="White"
                    BorderBrush="#FFD6DCE8"
                    BorderThickness="1"
                    CornerRadius="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,12"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="脚本列表" />

                    <ListBox x:Name="ScriptsListBox"
                             BorderThickness="0"
                             ItemsSource="{Binding Scripts}"
                             SelectedItem="{Binding SelectedScript, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="12"
                                        Background="#FFF8FAFC"
                                        BorderBrush="#FFE2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Name}" />
                                            <Border DockPanel.Dock="Right"
                                                    Padding="8,2"
                                                    Background="#FFE8EEF9"
                                                    CornerRadius="10">
                                                <TextBlock Foreground="#FF2D4A7A"
                                                           Text="{Binding StatusText}" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="#FF4A5568"
                                                   Text="{Binding Description}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,8,0,0"
                                                   FontFamily="Consolas"
                                                   Foreground="#FF718096"
                                                   Text="{Binding FileName}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="12"
                    Background="White"
                    BorderBrush="#FFD6DCE8"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="运行控制" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#FF4A5568"
                                   Text="{Binding SelectedScriptSummary, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="0,16,0,16"
                                Orientation="Horizontal">
                        <Button Width="110" Margin="0,0,8,0" Click="RunButton_OnClick" Content="运行脚本" />
                        <Button Width="110" Margin="0,0,8,0" Click="StopButton_OnClick" Content="停止脚本" />
                        <Button Width="130" Click="OpenInEditorButton_OnClick" Content="外部编辑器打开" />
                    </StackPanel>

                    <DockPanel Grid.Row="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="运行日志" />
                            <TextBlock Margin="12,4,0,0"
                                       Foreground="#FF718096"
                                       Text="{Binding StatusMessage}" />
                        </DockPanel>

                        <TextBox IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 Text="{Binding LogOutput}" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
