<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="ScriptListItemTemplate">
        <Border Style="{StaticResource AppListItemCardStyle}"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Border.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                             Style="{StaticResource AppContextMenuStyle}">
                    <MenuItem Header="打开"
                              Command="{Binding OpenScriptCommand}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Style="{StaticResource AppContextMenuItemStyle}" />
                    <MenuItem Header="删除"
                              Command="{Binding DeleteScriptCommand}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Style="{StaticResource AppContextMenuItemStyle}" />
                </ContextMenu>
            </Border.ContextMenu>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Style="{StaticResource AppHeaderLine2}"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1">
                        <TextBlock Style="{StaticResource AppTips}"
                                   Margin="12,0,0,0"
                                   Text="{Binding FileName}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource AppContent}"
                           LineHeight="20"
                           MaxHeight="40"
                           Text="{Binding Description}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
