<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Thickness x:Key="AppOverlayBorderThickness">1</Thickness>

    <Style x:Key="AppOverlayCard" TargetType="Border">
        <Setter Property="Padding" 
                Value="10,8" />
        <Setter Property="Background" 
                Value="{StaticResource BrushBlack54}" />
        <Setter Property="BorderThickness" 
                Value="0" />
        <Setter Property="CornerRadius" 
                Value="8" />
    </Style>

    <Style x:Key="AppOverlayContent"
           TargetType="TextBlock"
           BasedOn="{StaticResource AppTips}">
        <Setter Property="FontSize"
                Value="11" />
    </Style>

    <Style x:Key="AppOverlayTitle"
           TargetType="TextBlock">
        <Setter Property="Margin"
                Value="0,2,0,0" />
        <Setter Property="Foreground"
                Value="{StaticResource BrushWhite87}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
    </Style>

    <Style x:Key="AppOverlayColorSwatch"
           TargetType="Border">
        <Setter Property="Width"
                Value="20" />
        <Setter Property="Height"
                Value="20" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Background"
                Value="{StaticResource BrushWhite}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource BrushWhite54}" />
        <Setter Property="BorderThickness"
                Value="{StaticResource AppOverlayBorderThickness}" />
        <Setter Property="CornerRadius"
                Value="4" />
    </Style>
</ResourceDictionary>
