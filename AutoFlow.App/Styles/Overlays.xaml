<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Thickness x:Key="AppOverlayPadding">10,8</Thickness>
    <CornerRadius x:Key="AppOverlayCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="AppOverlaySwatchCornerRadius">4</CornerRadius>
    <Thickness x:Key="AppOverlayBorderThickness">1</Thickness>
    <Thickness x:Key="AppOverlayValueMargin">0,2,0,0</Thickness>

    <Style x:Key="AppOverlayCard"
           TargetType="Border">
        <Setter Property="Padding"
                Value="{StaticResource AppOverlayPadding}" />
        <Setter Property="Background"
                Value="{StaticResource BrushGrey75}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource BrushWhite40}" />
        <Setter Property="BorderThickness"
                Value="{StaticResource AppOverlayBorderThickness}" />
        <Setter Property="CornerRadius"
                Value="{StaticResource AppOverlayCornerRadius}" />
    </Style>

    <Style x:Key="AppOverlayLabel"
           TargetType="TextBlock"
           BasedOn="{StaticResource AppTips}">
        <Setter Property="FontSize"
                Value="11" />
    </Style>

    <Style x:Key="AppOverlayPrimaryValue"
           TargetType="TextBlock">
        <Setter Property="MinWidth"
                Value="120" />
        <Setter Property="Margin"
                Value="{StaticResource AppOverlayValueMargin}" />
        <Setter Property="Foreground"
                Value="{StaticResource BrushWhite}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
    </Style>

    <Style x:Key="AppOverlaySecondaryValue"
           TargetType="TextBlock"
           BasedOn="{StaticResource AppOverlayPrimaryValue}">
        <Setter Property="FontSize"
                Value="13" />
    </Style>

    <Style x:Key="AppOverlayColorSwatch"
           TargetType="Border">
        <Setter Property="Width"
                Value="20" />
        <Setter Property="Height"
                Value="20" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Background"
                Value="{StaticResource BrushWhite}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource BrushWhite40}" />
        <Setter Property="BorderThickness"
                Value="{StaticResource AppOverlayBorderThickness}" />
        <Setter Property="CornerRadius"
                Value="{StaticResource AppOverlaySwatchCornerRadius}" />
    </Style>
</ResourceDictionary>
